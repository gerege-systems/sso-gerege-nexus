# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/platform_db?sslmode=disable
PORT=8080

# development | staging | production.
# "production" hardens several defaults: secure cookies, no mock national
# integrations, no demo data seeding.
ENVIRONMENT=development

# Path to the app-store catalog read at boot (manifests live next to it).
APP_CATALOG_PATH=catalog/apps.json

# Comma-separated CORS allow-list. Defaults to localhost:3000 when unset.
ALLOWED_ORIGINS=http://localhost:3000

# Set to true only when the API sits behind a proxy you control; otherwise
# X-Forwarded-For is attacker-controlled and defeats the login rate limiter.
TRUST_PROXY_HEADERS=false

# Creates the documented demo account (admin@example.com / Password123!).
# Defaults to on outside production.
SEED_DEMO_DATA=true

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ─── Gemini AI pipeline ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore

# ─── MinIO / Object Storage ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword

# ─── OAuth2 / OIDC provider ──────────────────────────────────────────────────
SSO_ISSUER=http://localhost:8080
# Secret for the built-in "gerege-dev-portal" client. Required in production;
# outside production a random one is generated and logged at startup.
SSO_DEFAULT_CLIENT_SECRET=

# ─── National integrations (E-ID, DAN, XYP) ──────────────────────────────────
# Mock mode returns canned identities and must never be implicit in production.
# Unset = enabled outside production, disabled in production.
EID_MOCK_MODE=true
DAN_MOCK_MODE=true
XYP_MOCK_MODE=true

EID_CLIENT_ID=
EID_CLIENT_SECRET=
# eID Mongolia relying-party credentials. The callback registered with eID
# should be ${PUBLIC_ORIGIN}/auth/eid/callback.
EID_BASE_URL=https://eidmongolia.mn/v3
EID_RP_UUID=
EID_RP_SECRET=
EID_RP_NAME=Gerege Nexus
EID_CERT_LEVEL=ADVANCED
EID_DISPLAY_TEXT=Gerege Nexus-д нэвтрэх
# Optional tenant slug for verified eID identities that have no existing
# Gerege Nexus account. New memberships receive the standard user role, never admin.
EID_JIT_TENANT_SLUG=

# eID Mongolia qualified remote signing (PDF E-Sign app). It reuses the relying
# party identity above — one RP registration carries both the authentication and
# the SIGNATURE permission — and layers signing-specific overrides on top.
#
# Mock mode serves canned ceremonies so the screens work without an RP
# registration. A document "signed" in mock mode carries no PKCS#7, no
# certificate chain and no revocation data: it is a demo artefact, not a legally
# valid signature. Never leave this on in production.
EID_SIGN_MOCK_MODE=true
# Defaults to EID_BASE_URL, then https://eidmongolia.mn/v3.
EID_SIGN_BASE_URL=
# The minimum certificate level accepted for a signature. QUALIFIED is what
# Mongolian law means by "тоон гарын үсэг"; accepting ADVANCED here would
# silently downgrade every document the platform produces.
EID_SIGN_CERT_LEVEL=QUALIFIED
# Shown on the phone above the PIN2 prompt (60 characters). Left empty, each
# ceremony names the document being signed, which is more useful.
EID_SIGN_DISPLAY_TEXT=

# Gerege eSign HSM (the older PDF signing rail). The key lives in the operator's
# HSM rather than with the citizen, so this does not produce a qualified
# signature; a tenant can disable it entirely from the signing policy screen.
ESIGN_MOCK_MODE=true
ESIGN_LOGIN_URL=https://hsm.gerege.mn/esign/login
ESIGN_SIGN_URL=https://hsm.gerege.mn/signer/signpdf
# Basic credential for the eSign service. Never returned to a browser.
ESIGN_TOKEN=
DAN_ENDPOINT=https://dan.gerege.mn/api/v1
DAN_API_KEY=
XYP_ENDPOINT=https://xyp.gerege.mn/api/v1
XYP_API_KEY=

# ─── Open Gerege RP-API ──────────────────────────────────────────────────────
# Relying Party credentials issued at registration. The secret is shown once —
# keep it in your local .env (git-ignored) or a secret manager, never in git.
# Calls send it as: Authorization: Bearer $RP_API_SECRET
RP_API_UUID=
RP_API_SECRET=

# ─── Outbound mail (OTP) ─────────────────────────────────────────────────────
# With SMTP_HOST or SMTP_PASSWORD empty the mailer logs the OTP instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_PASSWORD=

# Server Document-Signer for the PAdES fallback. Reached only when eID's own
# stamp endpoint is unavailable — it turns a stamp outage into a self-embedded
# signature rather than no signed PDF at all. Signing works without it.
#
# The certificate must be the SAME across restarts and replicas, so it is
# supplied rather than generated: a per-process key would make yesterday's
# fallback signatures unverifiable against today's certificate. Outside
# production a development self-signed pair is generated automatically.
#
# Either inline PEM (\n escapes are accepted) or a mounted file path.
EID_SIGN_SIGNER_CERT_PEM=
EID_SIGN_SIGNER_KEY_PEM=
# EID_SIGN_SIGNER_CERT_FILE=/run/secrets/eid-signer.crt
# EID_SIGN_SIGNER_KEY_FILE=/run/secrets/eid-signer.key
